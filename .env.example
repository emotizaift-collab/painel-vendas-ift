# Copie este arquivo para ".env" e preencha.
# Nenhum destes valores deve ser enviado para o GitHub.

# Porta em que o painel roda. Na maioria dos serviços de hospedagem pode deixar em branco.
PORT=3000

# Senha do aviso das planilhas. Invente uma senha longa e use a MESMA no Apps Script.
WEBHOOK_TOKEN=

# A chave do Google. Cole aqui o conteúdo INTEIRO do arquivo .json, em uma linha só.
# (Alternativa: deixe o arquivo em credentials/google-service-account.json.)
GOOGLE_SERVICE_ACCOUNT_JSON=

# De quanto em quanto tempo reler as planilhas por segurança, em milissegundos.
# 300000 = 5 minutos. Isso é só uma rede de proteção: o normal é o aviso instantâneo.
REFRESH_INTERVAL_MS=300000

# Fonte oficial de vendas. O token é usado somente no servidor e nunca vai para o navegador.
GREENN_API_URL=https://apiadm.greenn.com.br/api/v1/sales
# Cada perfil tem seu token e seus IDs de produto. Nunca publique tokens.
GREENN_BIANCA_TOKEN=
GREENN_BIANCA_PRODUCT_IDS=171399
GREENN_PALESTRANTE_TOKEN=
GREENN_PALESTRANTE_PRODUCT_IDS=
